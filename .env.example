# Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/semiconductor?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/semiconductor?sslmode=require"

# OpenAI（記事要約・分類、日次／週次サマリー）
ENABLE_AI=true
OPENAI_API_KEY="sk-..."

# DeepL（Freeキーは末尾が :fx）
DEEPL_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"

# Gmail 日次配信（Googleアカウントで2段階認証＋アプリパスワードを発行）
GMAIL_USER="your.name@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_TO="recipient@example.com"
MAIL_BCC="bcc@example.com"
DASHBOARD_URL="https://semiconductor-intelligence.vercel.app"

# (Optional) 株価API
ALPHA_VANTAGE_API_KEY="..."
